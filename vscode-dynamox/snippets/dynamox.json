{
  "Dynamox model": {
    "prefix": "model",
    "body": [
      "model ${1:ModelName} {",
      "  id String @id",
      "  ${2:name} String",
      "",
      "  @@table(name: \"${3:table_name}\")",
      "}"
    ],
    "description": "Create a Dynamox model with a primary key and table"
  },
  "Dynamox composite type": {
    "prefix": "type",
    "body": [
      "type ${1:TypeName} {",
      "  ${2:field} String",
      "}"
    ],
    "description": "Create a composite Dynamox type"
  },
  "Dynamox enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:Status} {",
      "  ${2:READY}",
      "  ${3:DONE}",
      "}"
    ],
    "description": "Create a Dynamox enum"
  },
  "Dynamox native document field": {
    "prefix": "document",
    "body": ["${1:field} ${2:Type} @document"],
    "description": "Store a named type as a native DynamoDB document"
  },
  "Dynamox heterogeneous JSON field": {
    "prefix": "jsonfield",
    "body": ["${1:payload} Json${2:?}"],
    "description": "Store a heterogeneous native DynamoDB value"
  }
}
