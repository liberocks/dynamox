{
  "name": "dynamox-vscode",
  "displayName": "Dynamox",
  "description": "Language support for Dynamox schemas with validation, completions, and formatting.",
  "version": "0.3.1",
  "publisher": "dynamox",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/liberocks/dynamox.git",
    "directory": "vscode-dynamox"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "keywords": [
    "dynamodb",
    "schema",
    "dynamox"
  ],
  "main": "out/src/extension.js",
  "activationEvents": [
    "onLanguage:dynamox"
  ],
  "contributes": {
    "languages": [
      {
        "id": "dynamox",
        "aliases": [
          "Dynamox",
          "dynamox"
        ],
        "extensions": [
          ".dynamox"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dynamox",
        "scopeName": "source.dynamox",
        "path": "./syntaxes/dynamox.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "dynamox",
        "path": "./snippets/dynamox.json"
      }
    ],
    "configuration": {
      "title": "Dynamox",
      "properties": {
        "dynamox.validationDelay": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "description": "Delay in milliseconds before validating an edited schema."
        }
      }
    }
  },
  "scripts": {
    "compile:ts": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "compile": "npm run compile:ts && node out/scripts/build-engine.js",
    "test": "npm run compile:ts && c8 --all --include='src/**/*.ts' --exclude-after-remap --reporter=text --reporter=lcov --check-coverage --per-file --lines=85 --functions=80 --branches=75 --statements=85 node --test tests/*.test.js",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "1.85.0",
    "c8": "^10.1.3",
    "typescript": "^5.9.3"
  }
}
