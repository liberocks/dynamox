type ThemeOption {
  value String
  next ThemeOption?
}

type Preferences {
  theme String
  digest Boolean
  alternate ThemeOption?
}

type DocumentMetadata {
  source String
  provider Json
  metadata Json?
}

model User {
  id String @id @default(uuidv7)
  name String
  preferences Preferences @jsonString
  documentPreferences DocumentMetadata @document
  optionalDocumentPreferences DocumentMetadata? @document
  providerPayload Json
  optionalPayload Json?
  payloads Json[]
  settings Preferences @jsonString
  optionalPreferences Preferences? @jsonString
  nickname String?
  posts Post[] @relation(fields: [id], references: [authorId], index: "ByAuthor")
  @@table(name: "users")
}

model Post {
  id String @id @default(objectid)
  authorId String
  editorId String?
  title String
  createdAt DateTime
  editTimes DateTime[]
  author User @relation(fields: [authorId], references: [id])
  editor User? @relation(fields: [editorId], references: [id])
  @@table(name: "posts")
  @@index(name: "ByAuthor", partition: authorId, sort: createdAt, type: GSI)
}

model SequenceItem {
  id Int @id @default(serial)
  value String
  @@table(name: "sequence_items")
}
